# Copy to .env and fill in. Never commit real secrets.

# AMap Web Service key. Held only here, server-side — never shipped to phones.
# Without it the server still runs but returns fallback estimates only.
AMAP_KEY=your_amap_web_service_key

# Shared secret the app sends as the X-App-Token header. Requests without a
# matching token get 401. Leave unset to open the endpoint (not recommended).
APP_TOKEN=change_me_to_a_long_random_string

# How long an identical analysis is cached (seconds). Short, because it
# captures live traffic. Default 60.
CACHE_TTL_SECS=60

# Listen address / port.
BIND_ADDR=0.0.0.0
PORT=8080
